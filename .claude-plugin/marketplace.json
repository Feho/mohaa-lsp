{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "mohaa-lsp",
  "description": "Morpheus Script language support for MOHAA",
  "owner": {
    "name": "MOHAA Community"
  },
  "plugins": [
    {
      "name": "morpheus-lsp",
      "description": "Morpheus Script language server for MOHAA .scr files",
      "version": "0.1.0",
      "author": {
        "name": "MOHAA Community"
      },
      "source": "./.claude-plugin/plugins/morpheus-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "morpheus-lsp": {
          "command": "node",
          "args": ["./packages/morpheus-lsp/dist/server.js", "--stdio"],
          "extensionToLanguage": {
            ".scr": "morpheus"
          }
        }
      }
    }
  ]
}
